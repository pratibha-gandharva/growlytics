rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & ownership verification
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Top-level User Document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && (request.resource.data.uid == userId || !('uid' in request.resource.data));
      allow update: if isOwner(userId)
                    && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if isOwner(userId);

      // Projects subcollection
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);

        // Project milestones (nested if stored as subcollection)
        match /milestones/{milestoneId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Roadmap Tasks subcollection
      match /roadmapTasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Study Sessions subcollection
      match /studySessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('durationMinutes' in request.resource.data) || request.resource.data.durationMinutes >= 0);
      }

      // Practice Records subcollection
      match /practiceRecords/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('questionsAttempted' in request.resource.data) || request.resource.data.questionsAttempted >= 0)
          && (!('questionsCorrect' in request.resource.data) || request.resource.data.questionsCorrect >= 0)
          && (!('questionsAttempted' in request.resource.data) || !('questionsCorrect' in request.resource.data) || request.resource.data.questionsCorrect <= request.resource.data.questionsAttempted);
      }

      // Skills subcollection
      match /skills/{skillId} {
        allow read, write: if isOwner(userId);
      }

      // User Preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // Chat / AI conversation persistence (if enabled)
      match /aiConversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Shared public benchmarks (read-only for authenticated or unauthenticated users)
    match /publicBenchmarks/{document=**} {
      allow read: if true;
      allow write: if false; // Read-only, managed server-side
    }

    // Default deny: strictly block any unhandled collection or document path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
