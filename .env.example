# Growlytics — Firebase Web App Client Configuration
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=growlytics-6b528.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=growlytics-6b528
VITE_FIREBASE_STORAGE_BUCKET=growlytics-6b528.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Optional: Cloud Function or Backend AI endpoint URL
VITE_AI_ENDPOINT_URL=
